{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "clearMocks": true,
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": [
    "<rootDir>/setup-e2e.ts"
  ],
  "testTimeout": 30000,
  "maxWorkers": 1
}
