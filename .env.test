# Integration-test environment. These are throwaway credentials for the local
# `db-test` container defined in docker-compose.yml — not secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ventriahq_test?schema=public

JWT_SECRET=integration-test-secret
JWT_EXPIRES=15m
REFRESH_EXPIRES_DAYS=30

REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ORIGIN=http://localhost:3000
